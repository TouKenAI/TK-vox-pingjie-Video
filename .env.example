# StepFun（阶跃星辰）API 配置模板
# 首次使用：把本文件复制为 .env，然后填入你自己的 API key（https://platform.stepfun.com）。
# ⚠ 真实 .env 含私人密钥，已被 .gitignore 排除，严禁提交或外传。

STEPFUN_API_KEY=在此填入你的StepFun_API_Key

# Base URL：
#   https://api.stepfun.com/step_plan/v1 → 走 Step Plan 订阅额度（token plan）
#   https://api.stepfun.com/v1           → 走按量计费余额
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1

# ── 模型 ──
STEPFUN_IMAGE_MODEL=step-image-edit-2
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_REALTIME_MODEL=step-1-8k
STEPFUN_CHAT_MODEL=step-2-16k
# 视觉"眼睛"：纯文本 Agent 通过它看图（原生多模态，走 Chat Completions 协议）
STEPFUN_VISION_MODEL=step-1v-8k

# ── 端点（一般无需改动，跟随 BASE_URL）──
STEPFUN_URL_IMAGES=https://api.stepfun.com/step_plan/v1/images/generations
STEPFUN_URL_SPEECH=https://api.stepfun.com/step_plan/v1/audio/speech
STEPFUN_URL_VOICES_PREVIEW=https://api.stepfun.com/step_plan/v1/audio/voices/preview
STEPFUN_URL_VOICES=https://api.stepfun.com/step_plan/v1/audio/voices
STEPFUN_URL_ASR_SSE=https://api.stepfun.com/step_plan/v1/audio/asr/sse
STEPFUN_URL_CHAT=https://api.stepfun.com/step_plan/v1/chat/completions
